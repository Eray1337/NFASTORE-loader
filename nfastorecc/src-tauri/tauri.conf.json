{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFAStore Loader",
  "version": "0.3.0",
  "identifier": "shop.nfastore.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NFAStore Loader",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0F0F0F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
